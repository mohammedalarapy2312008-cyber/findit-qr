# GEMINI_API_KEY: Server-side key for Gemini AI smart cover generation (gemini-3.1-flash-lite-image).
# Configure in AI Studio Settings > Secrets. Never expose with VITE_ prefix.
GEMINI_API_KEY=""

# APP_URL: Public base URL where FindIt QR is hosted (used in password reset & alert links).
APP_URL="http://localhost:3000"

# SUPER ADMIN CONFIGURATION (Server-side only — never expose in client bundle)
# Set ADMIN_EMAIL to the exact email address authorized as the sole Super Admin for /admin.
ADMIN_EMAIL=""

# TRANSACTIONAL EMAIL DELIVERY (Server-side only — configure ONE provider + EMAIL_FROM)
# Option A: Resend API (recommended)
RESEND_API_KEY=""
# Option B: SendGrid API
SENDGRID_API_KEY=""
# Option C: Standard SMTP (e.g., Zoho, Amazon SES, Mailgun, Gmail App Password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Verified sender address for Resend/SendGrid/SMTP (e.g., FindIt QR <no-reply@finditqr.com>)
EMAIL_FROM=""

# WHATSAPP BUSINESS ALERTS (Server-side only — optional, configure ONE provider)
# Option A: Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="ar"
# Option B: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# PERMANENT CLOUD MEDIA STORAGE — CLOUDFLARE R2 (Server-side only — never expose with VITE_ prefix)
# STORAGE_DRIVER: "local_persistent" (fallback default) or "s3_compatible" (or "r2") for Cloudflare R2
STORAGE_DRIVER="local_persistent"
# Cloudflare R2 S3 API Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# Cloudflare R2 Bucket Name (e.g., finditqr-media)
S3_BUCKET=""
# Cloudflare R2 Region (must be "auto")
S3_REGION="auto"
# Cloudflare R2 API Token credentials (Object Read & Write permission scoped to the bucket)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom public base URL (not required; media is served securely through /api/media/* with access control)
S3_PUBLIC_BASE_URL=""

# FIREBASE CLOUD STORAGE OPTIONAL OVERRIDE (Requires Firebase Blaze plan approval before deploying storage.rules)
FIREBASE_STORAGE_BUCKET=""

# FIREBASE PUBLIC CLIENT CONFIG (Provisioned automatically via firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FUNCTIONS_REGION="europe-west1"
